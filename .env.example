# The ImageShield /v1 API URL, exposed to the browser so it can call the backend
# directly with bearer tokens. Must be https in production. A trailing slash is
# fine — it gets normalized away.
NEXT_PUBLIC_IMAGESHIELD_API_URL=https://dev.imageshield.com

# Signs the HMAC share tokens issued by /api/share/score-token and verified by
# /api/share/score-card. Server-only — never exposed to the browser.
# Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters; the server refuses anything shorter.
SCORE_SHARE_SECRET=replace-me

# The link a shared Likeness Health Score points people to — printed on the share
# poster and put in its caption. The result screen's QR is built on it too, as
# <this>/get-app. Optional: it defaults to the deployed funnel, the
# same address the mobile app shares. Set it only if the funnel moves. Not the
# address bar: in development that is localhost, which no one who receives the
# share can open.
# NEXT_PUBLIC_SHARE_URL=https://quiz.imageshield.com
