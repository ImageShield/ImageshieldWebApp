# The ImageShield /v1 API — the same API the mobile app's services/v1 client talks to.
# Server-side only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
# This repo is public, so the real host lives only in .env.local and in the
# deployment's env config; ask the team for it rather than guessing.
# Must be an absolute URL with no query, fragment, or embedded credentials, and must
# be https in production. A trailing slash is fine — it gets normalized away.
#
# This replaced BACKEND_URL, which pointed at the legacy phone-keyed backend. The
# rename is deliberate: /v1 accepts no identifier as the actor anywhere, so pointing
# the old variable at the new host would not have failed loudly — it would have 404d
# its way through a lead's funnel run. Startup rejects a config that still sets
# BACKEND_URL without this one.
IMAGESHIELD_API_URL=https://dev.imageshield.com

# How many proxies sit in front of this app, each appending to X-Forwarded-For.
# Defaults to 1 — an nginx in front. The per-IP OTP limit counts against the entry
# that many from the RIGHT of that header, which is the one the nearest proxy wrote
# and so the one a client cannot forge; leftmost entries are whatever the caller
# claimed. Set to 0 when nothing trusted is in front (every caller then shares one
# bucket), or to 2+ when a CDN also appends. Leave it unset for the default; a value
# that isn't a non-negative integer is rejected at startup rather than silently
# falling back, because a typo here would quietly redefine which entry is trusted.
TRUSTED_PROXY_HOPS=1

# Signs the funnel's PRE-VERIFICATION cookie: the name, email and phone a visitor
# typed, and the id of the OTP challenge they were issued. Those are claims this
# server acts on before any session exists, so they have to be tamper-proof — an
# unsigned cookie would let a visitor swap in a challenge id that isn't theirs.
# Generate your own; leaving this as "replace-me" is refused at startup, since anyone
# who has read this public repo could otherwise forge one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters; production refuses anything shorter, dev only warns.
#
# The token cookie beside it carries no signature and needs none — /v1 access and
# refresh tokens authenticate themselves, and a forged one is simply a 401.
FUNNEL_SECRET=replace-me

# The link a shared Likeness Health Score points people to — printed on the share
# poster and put in its caption. The result screen's QR is built on it too, as
# <this>/get-app. Optional: it defaults to the deployed funnel, the
# same address the mobile app shares. Set it only if the funnel moves. Not the
# address bar: in development that is localhost, which no one who receives the
# share can open.
# NEXT_PUBLIC_SHARE_URL=https://quiz.imageshield.com
